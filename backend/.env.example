# Server
NODE_ENV=production
PORT=5000
CORS_ORIGIN=http://localhost:3000,https://your-frontend.onrender.com,https://your-frontend.vercel.app

# Database (Supabase PostgreSQL - Use IPv4 Pooler endpoint on Render/Cloud)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage & APIs
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="medical-records"

# Google Gemini AI (Multimodal Vision OCR & Clinical Assistant)
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"

# Security & Sessions
JWT_SECRET="your_secure_random_jwt_secret_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"
CRON_SECRET="optional_secret_for_cron_webhook"

# Upstash Redis Distributed Cache Layer
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

