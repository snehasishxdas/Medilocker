datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PATIENT
  DOCTOR
  HOSPITAL
}

enum DocumentType {
  PRESCRIPTION
  REPORT
  SCAN
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TimeSlot {
  MORNING
  AFTERNOON
  NIGHT
  PRN
}

enum SeverityColor {
  GREEN
  ORANGE
  RED
}

enum DelegationStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuthMethod {
  MPIN
  BIOMETRIC
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ScanMethod {
  BARCODE_1D
  DATAMATRIX_2D
  AI_PHOTO_OCR
  MANUAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id                   String            @id @default(uuid())
  medilockerId         String            @unique @map("medilocker_id")
  email                String            @unique
  phone                String
  role                 UserRole
  mpinHash             String?           @map("mpin_hash")
  webauthnCredentialId String?           @map("webauthn_credential_id")
  webauthnPublicKey    String?           @map("webauthn_public_key")
  webauthnSignCount    Int               @default(0) @map("webauthn_sign_count")
  isVerified           Boolean           @default(false) @map("is_verified")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  patientProfile       PatientProfile?
  doctorProfile        DoctorProfile?
  hospitalProfile      HospitalProfile?
  medicalRecords       MedicalRecord[]
  timelineEvents       TimelineEvent[]
  prescribedMeds       PrescribedMedication[]
  todoItems            DailyTodoItem[]
  feelingLogs          DailyFeelingLog[]
  homeSupplies         MedicineInventoryHome[]
  refillReminders      RefillReminder[]
  delegations          PatientAccessDelegation[]
  appointments         Appointment[]
  auditLogs            AuditLog[]

  @@map("users")
}

model PatientProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String    @map("full_name")
  dob                   DateTime?
  gender                String?
  bloodGroup            String?   @map("blood_group")
  govidEncrypted        String?   @map("govid_encrypted")
  insuranceProvider     String?   @map("insurance_provider")
  insurancePolicyNumber String?   @map("insurance_policy_number")
  baselineAllergies     String?   @map("baseline_allergies")
  baselineMedications   String?   @map("baseline_medications")
  medicalHistory        String?   @map("medical_history")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  addressLine           String?   @map("address_line")
  city                  String?
  state                 String?
  pincode               String?
  pregnancyStatus       Boolean   @default(false) @map("pregnancy_status")
  alcoholUse            Boolean   @default(false) @map("alcohol_use")
  chronicConditions     String[]  @map("chronic_conditions")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("patient_profiles")
}

model DoctorProfile {
  id                    String             @id @default(uuid())
  userId                String             @unique @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String             @map("full_name")
  professionalEmail     String             @map("professional_email")
  phone                 String
  institutionalDoctorId String             @map("institutional_doctor_id")
  registrationNumber    String             @unique @map("registration_number")
  specialization        String
  registrationDate      DateTime?          @map("registration_date")
  yearsExperience       Int                @default(0) @map("years_experience")
  clinicName            String             @map("clinic_name")
  clinicVerificationRef String?            @map("clinic_verification_ref")
  clinicAddress         String             @map("clinic_address")
  city                  String
  state                 String?
  degree                String?
  certificateUrl        String?            @map("certificate_url")
  verificationStatus    VerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  hospitalDoctors       HospitalDoctor[]
  assignedDelegations   PatientAccessDelegation[]
  appointments          Appointment[]

  @@map("doctor_profiles")
}

model HospitalProfile {
  id                       String             @id @default(uuid())
  userId                   String             @unique @map("user_id")
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalName             String             @map("hospital_name")
  officialEmail            String             @map("official_email")
  phone                    String
  hospitalId               String             @unique @map("hospital_id")
  licenseNumber            String             @unique @map("license_number")
  registrationDate         DateTime?          @map("registration_date")
  address                  String
  city                     String
  state                    String?
  hospitalType             String?            @map("hospital_type")
  hospitalOwnership        String?            @default("PRIVATE") @map("hospital_ownership")
  bedCapacity              Int                @default(0) @map("bed_capacity")
  authorizedRepresentative String?            @map("authorized_representative")
  managingDirectorName      String?            @map("managing_director_name")
  managingDirectorContact   String?            @map("managing_director_contact")
  govtSchemesAvailable      Boolean            @default(false) @map("govt_schemes_available")
  govtSchemesList           String[]           @default([]) @map("govt_schemes_list")
  registrationCertificateUrl String?          @map("registration_certificate_url")
  verificationStatus       VerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  verificationRef          String?            @map("verification_ref")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  hospitalDoctors          HospitalDoctor[]
  delegations              PatientAccessDelegation[]

  @@map("hospital_profiles")
}

model HospitalDoctor {
  id         String          @id @default(uuid())
  hospitalId String          @map("hospital_id")
  hospital   HospitalProfile @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorId   String          @map("doctor_id")
  doctor     DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department String?
  isActive   Boolean         @default(true) @map("is_active")
  allottedAt DateTime        @default(now()) @map("allotted_at")

  @@unique([hospitalId, doctorId])
  @@map("hospital_doctors")
}

model MedicalRecord {
  id               String           @id @default(uuid())
  patientId        String           @map("patient_id")
  patient          User             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  originalFilename String           @map("original_filename")
  storageKey       String           @map("storage_key")
  mimeType         String           @map("mime_type")
  fileSizeBytes    BigInt           @map("file_size_bytes")
  sha256Checksum   String           @map("sha256_checksum")
  documentType     DocumentType     @map("document_type")
  userNote         String?          @map("user_note")
  fileUrl          String?          @map("file_url")
  doctorUnitId     String?          @map("doctor_unit_id")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  uploadedAt       DateTime         @default(now()) @map("uploaded_at")

  timelineEvent    TimelineEvent?

  @@map("medical_records")
}

model TimelineEvent {
  id                String       @id @default(uuid())
  recordId          String       @unique @map("record_id")
  record            MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  patientId         String       @map("patient_id")
  patient           User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventDateDdmmyyyy String       @map("event_date_ddmmyyyy")
  doctorName        String?      @map("doctor_name")
  clinicName        String?      @map("clinic_name")
  diagnoses         Json         @default("[]")
  allergiesDetected Json         @default("[]") @map("allergies_detected")
  clinicalTestsDue  Json         @default("[]") @map("clinical_tests_due")
  clinicalSummary   String?      @map("clinical_summary")
  createdAt         DateTime     @default(now()) @map("created_at")

  prescribedMeds    PrescribedMedication[]

  @@index([patientId, eventDateDdmmyyyy])
  @@map("timeline_events")
}

model PrescribedMedication {
  id                  String        @id @default(uuid())
  timelineEventId     String        @map("timeline_event_id")
  timelineEvent       TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  patientId           String        @map("patient_id")
  patient             User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName        String        @map("medicine_name")
  activeSalt          String?       @map("active_salt")
  dosage              String
  frequency           String
  route               String        @default("Oral")
  timingInstruction   String?       @map("timing_instruction")
  courseStartDate     DateTime      @map("course_start_date")
  courseEndDate       DateTime      @map("course_end_date")
  totalQuantityNeeded Int           @map("total_quantity_needed")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")

  todoItems           DailyTodoItem[]
  refillReminders     RefillReminder[]

  @@map("prescribed_medications")
}

model DailyTodoItem {
  id            String                @id @default(uuid())
  patientId     String                @map("patient_id")
  patient       User                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId  String?               @map("medication_id")
  medication    PrescribedMedication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduleDate  DateTime              @map("schedule_date")
  timeSlot      TimeSlot              @map("time_slot")
  taskLabel     String                @map("task_label")
  isCompleted   Boolean               @default(false) @map("is_completed")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([patientId, scheduleDate])
  @@map("daily_todo_items")
}

model DailyFeelingLog {
  id              String        @id @default(uuid())
  patientId       String        @map("patient_id")
  patient         User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  logDate         DateTime      @map("log_date")
  feelingScore    Int           @map("feeling_score")
  severityColor   SeverityColor @map("severity_color")
  patientFeedback String?       @map("patient_feedback")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([patientId, logDate])
  @@map("daily_feeling_logs")
}

model MedicineInventoryHome {
  id                String      @id @default(uuid())
  patientId         String      @map("patient_id")
  patient           User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName      String      @map("medicine_name")
  activeSalt        String?     @map("active_salt")
  quantityAvailable Int         @default(0) @map("quantity_available")
  expiryDate        DateTime?   @map("expiry_date")
  barcodeGtin       String?     @map("barcode_gtin")
  batchNumber       String?     @map("batch_number")
  scanMethod        ScanMethod  @default(MANUAL) @map("scan_method")
  aiCategory        String?     @map("ai_category")
  aiUsesDescription String?     @map("ai_uses_description")
  aiPrecautions     String?     @map("ai_precautions")
  addedAt           DateTime    @default(now()) @map("added_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([patientId, barcodeGtin])
  @@map("medicine_inventory_home")
}

model RefillReminder {
  id                     String               @id @default(uuid())
  patientId              String               @map("patient_id")
  patient                User                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId           String               @map("medication_id")
  medication             PrescribedMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  purchasedQuantity      Int                  @map("purchased_quantity")
  remainingQuantity      Int                  @map("remaining_quantity")
  dailyConsumptionRate   Int                  @default(1) @map("daily_consumption_rate")
  estimatedDepletionDate DateTime             @map("estimated_depletion_date")
  alertDate              DateTime             @map("alert_date")
  isAlertTriggered       Boolean              @default(false) @map("is_alert_triggered")
  epharmacyLink          String?              @map("epharmacy_link")
  createdAt              DateTime             @default(now()) @map("created_at")

  @@index([patientId, alertDate, isAlertTriggered])
  @@map("refill_reminders")
}

model PatientAccessDelegation {
  id                       String           @id @default(uuid())
  patientId                String           @map("patient_id")
  patient                  User             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId               String?          @map("hospital_id")
  hospital                 HospitalProfile? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  allottedDoctorId         String           @map("allotted_doctor_id")
  allottedDoctor           DoctorProfile    @relation(fields: [allottedDoctorId], references: [id], onDelete: Cascade)
  authorizationMethod      AuthMethod       @default(MPIN) @map("authorization_method")
  authCode                 String?          @map("auth_code")
  codeExpiresAt            DateTime?        @map("code_expires_at")
  requestedDurationMinutes Int              @default(120) @map("requested_duration_minutes")
  status                   DelegationStatus @default(REQUESTED)
  grantedAt                DateTime?        @map("granted_at")
  expiresAt                DateTime?        @map("expires_at")
  revokedAt                DateTime?        @map("revoked_at")
  createdAt                DateTime         @default(now()) @map("created_at")

  @@index([patientId, allottedDoctorId, status])
  @@map("patient_access_delegations")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  eventDetails Json?    @map("event_details")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  patient         User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String            @map("doctor_id")
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate DateTime          @map("appointment_date")
  timeSlot        String            @map("time_slot")
  status          AppointmentStatus @default(PENDING)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([patientId, doctorId, appointmentDate])
  @@map("appointments")
}
